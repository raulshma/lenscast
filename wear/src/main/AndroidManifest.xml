<?xml version="1.0" encoding="utf-8"?>
<!--
  LensCast Wear — watch-side remote for the LensCast phone server.

  INTERNET is the only permission: every control in this app is an HTTP
  round trip to the paired phone's LAN server (see wear/README.md for the
  WiFi-path caveat). No Wear Data Layer, no body sensors, no background
  services — the remote lives entirely in its two activities.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- A watch form factor is assumed everywhere (round layout, Wear
         Compose components); do not offer this APK to non-wear devices. -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- The launcher entry: status header, stream/photo controls and the
             snapshot pane. singleTask keeps one remote instance across
             relaunches from the app list. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Connection settings (host, port, credentials) plus the live
             connection test. Not exported: only this app opens it. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
    </application>
</manifest>
