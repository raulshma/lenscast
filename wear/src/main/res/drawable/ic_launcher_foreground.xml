<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher glyph: abstract lens — concentric rings with a highlight
     notch, echoing the phone app's camera identity in one flat vector. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer barrel -->
    <path
        android:pathData="M54,54m-24,0a24,24 0,1 1,48 0a24,24 0,1 1,-48 0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:fillColor="#00000000" />
    <!-- Inner element -->
    <path
        android:pathData="M54,54m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0"
        android:fillColor="#FFFFFF" />
    <!-- Mirror-chip highlight -->
    <path
        android:pathData="M54,54m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"
        android:fillColor="#5B8DEF" />
</vector>
