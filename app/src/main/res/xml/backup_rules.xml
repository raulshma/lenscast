<?xml version="1.0" encoding="utf-8"?><!--
   Full-backup content rules (ignored on API 31+, which uses
   data_extraction_rules.xml). Excludes only what must never leave the
   device: the auth session tokens and the detection-event log (its entries
   embed base64 camera snapshots).
-->
<full-backup-content>
    <exclude domain="file" path="auth/sessions.json" />
    <exclude domain="file" path="detection_events.json" />
</full-backup-content>
